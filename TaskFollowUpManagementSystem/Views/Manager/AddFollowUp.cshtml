@model CreateFollowUpViewModel
@{
    ViewData["Title"] = "إضافة متابعة";
}

<div class="page-header">
    <h2><i class="bi bi-chat-dots"></i> إضافة متابعة</h2>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card shadow">
            <div class="card-body p-4">
                <div class="alert alert-info">
                    <strong>المهمة:</strong> @Model.TaskTitle<br />
                    <strong>الموظف:</strong> @Model.EmployeeName
                </div>

                <form asp-action="AddFollowUp" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="TaskItemId" />

                    <div class="mb-3">
                        <label asp-for="FollowUpDate" class="form-label">تاريخ المتابعة</label>
                        <input asp-for="FollowUpDate" type="date" class="form-control" />
                        <span asp-validation-for="FollowUpDate" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Note" class="form-label">ملاحظة المتابعة</label>
                        <textarea asp-for="Note" class="form-control" rows="5" placeholder="اكتب ملاحظة المتابعة هنا..."></textarea>
                        <span asp-validation-for="Note" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-send"></i> إرسال المتابعة</button>
                        <a asp-action="TaskDetails" asp-route-id="@Model.TaskItemId" class="btn btn-outline-secondary">إلغاء</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
