@model CreateFollowUpViewModel
@{
    ViewData["Title"] = "Add Follow-Up";
}

<h2 class="mb-4"><i class="bi bi-chat-dots"></i> Add Follow-Up</h2>

<div class="row">
    <div class="col-md-8">
        <div class="card shadow">
            <div class="card-body p-4">
                <div class="alert alert-info">
                    <strong>Task:</strong> @Model.TaskTitle<br />
                    <strong>Employee:</strong> @Model.EmployeeName
                </div>

                <form asp-action="AddFollowUp" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="TaskItemId" />

                    <div class="mb-3">
                        <label asp-for="FollowUpDate" class="form-label"></label>
                        <input asp-for="FollowUpDate" type="date" class="form-control" />
                        <span asp-validation-for="FollowUpDate" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Note" class="form-label"></label>
                        <textarea asp-for="Note" class="form-control" rows="5" placeholder="Write your follow-up note..."></textarea>
                        <span asp-validation-for="Note" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-send"></i> Send Follow-Up</button>
                        <a asp-action="TaskDetails" asp-route-id="@Model.TaskItemId" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
