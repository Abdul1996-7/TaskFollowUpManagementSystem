@model ManagerDashboardViewModel
@{
    ViewData["Title"] = "Manager Dashboard";
}

<h2 class="mb-4"><i class="bi bi-speedometer2"></i> Manager Dashboard</h2>

<div class="row g-4 mb-4">
    <div class="col-md-2">
        <div class="card bg-primary text-white shadow h-100">
            <div class="card-body text-center">
                <i class="bi bi-list-task" style="font-size: 2rem;"></i>
                <h3 class="mt-2">@Model.TotalTasks</h3>
                <p class="mb-0 small">Total Tasks</p>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card bg-success text-white shadow h-100">
            <div class="card-body text-center">
                <i class="bi bi-check-circle" style="font-size: 2rem;"></i>
                <h3 class="mt-2">@Model.CompletedTasks</h3>
                <p class="mb-0 small">Completed</p>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card bg-info text-white shadow h-100">
            <div class="card-body text-center">
                <i class="bi bi-arrow-repeat" style="font-size: 2rem;"></i>
                <h3 class="mt-2">@Model.InProgressTasks</h3>
                <p class="mb-0 small">In Progress</p>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card bg-danger text-white shadow h-100">
            <div class="card-body text-center">
                <i class="bi bi-exclamation-triangle" style="font-size: 2rem;"></i>
                <h3 class="mt-2">@Model.OverdueTasks</h3>
                <p class="mb-0 small">Overdue</p>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card bg-warning text-dark shadow h-100">
            <div class="card-body text-center">
                <i class="bi bi-star" style="font-size: 2rem;"></i>
                <h3 class="mt-2">@Model.NewTasks</h3>
                <p class="mb-0 small">New/Assigned</p>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card bg-secondary text-white shadow h-100">
            <div class="card-body text-center">
                <i class="bi bi-hourglass-split" style="font-size: 2rem;"></i>
                <h3 class="mt-2">@Model.PendingReviewTasks</h3>
                <p class="mb-0 small">Pending Review</p>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-chat-dots"></i> Recent Follow-Ups</h5>
                <a asp-action="FollowUps" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <div class="card-body p-0">
                @if (Model.RecentFollowUps.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var followUp in Model.RecentFollowUps)
                        {
                            <div class="list-group-item">
                                <div class="d-flex justify-content-between">
                                    <strong>@followUp.TaskTitle</strong>
                                    @if (followUp.HasResponse)
                                    {
                                        <span class="badge bg-success">Responded</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    }
                                </div>
                                <small class="text-muted">@followUp.EmployeeName - @followUp.FollowUpDate.ToString("MMM dd, yyyy")</small>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted p-3">No recent follow-ups.</p>
                }
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-light">
                <h5 class="mb-0"><i class="bi bi-people"></i> Tasks by Employee</h5>
            </div>
            <div class="card-body p-0">
                @if (Model.TasksByEmployee.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Employee</th>
                                    <th class="text-center">Total</th>
                                    <th class="text-center">Done</th>
                                    <th class="text-center">Active</th>
                                    <th class="text-center">Overdue</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var emp in Model.TasksByEmployee)
                                {
                                    <tr>
                                        <td>@emp.EmployeeName</td>
                                        <td class="text-center"><span class="badge bg-primary">@emp.TotalTasks</span></td>
                                        <td class="text-center"><span class="badge bg-success">@emp.CompletedTasks</span></td>
                                        <td class="text-center"><span class="badge bg-info">@emp.InProgressTasks</span></td>
                                        <td class="text-center"><span class="badge bg-danger">@emp.OverdueTasks</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted p-3">No tasks assigned yet.</p>
                }
            </div>
        </div>
    </div>
</div>

<div class="mt-4">
    <a asp-action="CreateTask" class="btn btn-primary me-2"><i class="bi bi-plus-circle"></i> Create New Task</a>
    <a asp-action="Tasks" class="btn btn-outline-secondary"><i class="bi bi-list-task"></i> View All Tasks</a>
</div>
