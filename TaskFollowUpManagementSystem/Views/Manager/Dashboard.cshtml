@model ManagerDashboardViewModel
@{
    ViewData["Title"] = "لوحة تحكم المدير";
}

<div class="page-header">
    <h2><i class="bi bi-speedometer2"></i> لوحة تحكم المدير</h2>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-2">
        <div class="card stat-card bg-primary text-white shadow h-100">
            <div class="card-body text-center">
                <div class="stat-icon"><i class="bi bi-list-task"></i></div>
                <div class="stat-number">@Model.TotalTasks</div>
                <p class="stat-label">إجمالي المهام</p>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card stat-card bg-success text-white shadow h-100">
            <div class="card-body text-center">
                <div class="stat-icon"><i class="bi bi-check-circle"></i></div>
                <div class="stat-number">@Model.CompletedTasks</div>
                <p class="stat-label">مكتملة</p>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card stat-card bg-info text-white shadow h-100">
            <div class="card-body text-center">
                <div class="stat-icon"><i class="bi bi-arrow-repeat"></i></div>
                <div class="stat-number">@Model.InProgressTasks</div>
                <p class="stat-label">قيد التنفيذ</p>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card stat-card bg-danger text-white shadow h-100">
            <div class="card-body text-center">
                <div class="stat-icon"><i class="bi bi-exclamation-triangle"></i></div>
                <div class="stat-number">@Model.OverdueTasks</div>
                <p class="stat-label">متأخرة</p>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card stat-card bg-warning text-dark shadow h-100">
            <div class="card-body text-center">
                <div class="stat-icon"><i class="bi bi-star"></i></div>
                <div class="stat-number">@Model.NewTasks</div>
                <p class="stat-label">جديدة/معيّنة</p>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card stat-card bg-secondary text-white shadow h-100">
            <div class="card-body text-center">
                <div class="stat-icon"><i class="bi bi-hourglass-split"></i></div>
                <div class="stat-number">@Model.PendingReviewTasks</div>
                <p class="stat-label">بانتظار المراجعة</p>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-chat-dots"></i> آخر المتابعات</h5>
                <a asp-action="FollowUps" class="btn btn-sm btn-outline-primary">عرض الكل</a>
            </div>
            <div class="card-body p-0">
                @if (Model.RecentFollowUps.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var followUp in Model.RecentFollowUps)
                        {
                            <div class="list-group-item">
                                <div class="d-flex justify-content-between">
                                    <strong>@followUp.TaskTitle</strong>
                                    @if (followUp.HasResponse)
                                    {
                                        <span class="badge bg-success">تم الرد</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">بانتظار الرد</span>
                                    }
                                </div>
                                <small class="text-muted">@followUp.EmployeeName - @followUp.FollowUpDate.ToString("yyyy/MM/dd")</small>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <div class="empty-icon"><i class="bi bi-chat-dots"></i></div>
                        <div class="empty-title">لا توجد متابعات حديثة</div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-light">
                <h5 class="mb-0"><i class="bi bi-people"></i> المهام حسب الموظف</h5>
            </div>
            <div class="card-body p-0">
                @if (Model.TasksByEmployee.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>الموظف</th>
                                    <th class="text-center">الإجمالي</th>
                                    <th class="text-center">مكتملة</th>
                                    <th class="text-center">نشطة</th>
                                    <th class="text-center">متأخرة</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var emp in Model.TasksByEmployee)
                                {
                                    <tr>
                                        <td>@emp.EmployeeName</td>
                                        <td class="text-center"><span class="badge bg-primary">@emp.TotalTasks</span></td>
                                        <td class="text-center"><span class="badge bg-success">@emp.CompletedTasks</span></td>
                                        <td class="text-center"><span class="badge bg-info">@emp.InProgressTasks</span></td>
                                        <td class="text-center"><span class="badge bg-danger">@emp.OverdueTasks</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <div class="empty-icon"><i class="bi bi-people"></i></div>
                        <div class="empty-title">لا توجد مهام معيّنة بعد</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="mt-4">
    <a asp-action="CreateTask" class="btn btn-primary"><i class="bi bi-plus-circle"></i> إنشاء مهمة جديدة</a>
    <a asp-action="Tasks" class="btn btn-outline-secondary"><i class="bi bi-list-task"></i> عرض جميع المهام</a>
</div>
