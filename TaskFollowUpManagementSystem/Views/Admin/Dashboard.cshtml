@model AdminDashboardViewModel
@{
    ViewData["Title"] = "لوحة تحكم المدير";
}

<div class="page-header">
    <h2><i class="bi bi-speedometer2"></i> لوحة تحكم مدير النظام</h2>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card stat-card bg-primary text-white shadow h-100">
            <div class="card-body text-center">
                <div class="stat-icon"><i class="bi bi-people"></i></div>
                <div class="stat-number">@Model.TotalUsers</div>
                <p class="stat-label">إجمالي المستخدمين</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card bg-success text-white shadow h-100">
            <div class="card-body text-center">
                <div class="stat-icon"><i class="bi bi-person-badge"></i></div>
                <div class="stat-number">@Model.TotalManagers</div>
                <p class="stat-label">المديرون</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card bg-info text-white shadow h-100">
            <div class="card-body text-center">
                <div class="stat-icon"><i class="bi bi-person"></i></div>
                <div class="stat-number">@Model.TotalEmployees</div>
                <p class="stat-label">الموظفون</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card bg-warning text-dark shadow h-100">
            <div class="card-body text-center">
                <div class="stat-icon"><i class="bi bi-list-task"></i></div>
                <div class="stat-number">@Model.TotalTasks</div>
                <p class="stat-label">إجمالي المهام</p>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-light">
                <h5 class="mb-0"><i class="bi bi-lightning"></i> إجراءات سريعة</h5>
            </div>
            <div class="card-body">
                <a asp-action="Users" class="quick-action">
                    <i class="bi bi-people text-primary"></i>
                    <span>إدارة المستخدمين</span>
                </a>
                <a asp-action="CreateUser" class="quick-action">
                    <i class="bi bi-person-plus text-success"></i>
                    <span>إنشاء مستخدم جديد</span>
                </a>
            </div>
        </div>
    </div>
</div>
