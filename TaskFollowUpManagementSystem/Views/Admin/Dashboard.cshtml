@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<h2 class="mb-4"><i class="bi bi-speedometer2"></i> Admin Dashboard</h2>

<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card bg-primary text-white shadow h-100">
            <div class="card-body text-center">
                <i class="bi bi-people" style="font-size: 2.5rem;"></i>
                <h3 class="mt-2">@Model.TotalUsers</h3>
                <p class="mb-0">Total Users</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-success text-white shadow h-100">
            <div class="card-body text-center">
                <i class="bi bi-person-badge" style="font-size: 2.5rem;"></i>
                <h3 class="mt-2">@Model.TotalManagers</h3>
                <p class="mb-0">Managers</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-info text-white shadow h-100">
            <div class="card-body text-center">
                <i class="bi bi-person" style="font-size: 2.5rem;"></i>
                <h3 class="mt-2">@Model.TotalEmployees</h3>
                <p class="mb-0">Employees</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-warning text-dark shadow h-100">
            <div class="card-body text-center">
                <i class="bi bi-list-task" style="font-size: 2.5rem;"></i>
                <h3 class="mt-2">@Model.TotalTasks</h3>
                <p class="mb-0">Total Tasks</p>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-light">
                <h5 class="mb-0"><i class="bi bi-lightning"></i> Quick Actions</h5>
            </div>
            <div class="card-body">
                <a asp-action="Users" class="btn btn-outline-primary me-2 mb-2"><i class="bi bi-people"></i> Manage Users</a>
                <a asp-action="CreateUser" class="btn btn-outline-success me-2 mb-2"><i class="bi bi-person-plus"></i> Create User</a>
            </div>
        </div>
    </div>
</div>
