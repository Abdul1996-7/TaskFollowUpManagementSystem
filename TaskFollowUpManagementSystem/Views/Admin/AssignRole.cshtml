@model AssignRoleViewModel
@{
    ViewData["Title"] = "تعيين دور";
}

<div class="page-header">
    <h2><i class="bi bi-person-gear"></i> تعيين دور المستخدم</h2>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-body p-4">
                <div class="mb-3">
                    <div class="info-row">
                        <span class="info-label">المستخدم:</span>
                        <span class="info-value"><strong>@Model.FullName</strong></span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">البريد الإلكتروني:</span>
                        <span class="info-value">@Model.Email</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">الدور الحالي:</span>
                        <span class="info-value"><span class="badge bg-secondary">@Model.CurrentRole</span></span>
                    </div>
                </div>
                <hr />
                <form asp-action="AssignRole" method="post">
                    <input type="hidden" asp-for="UserId" />
                    <input type="hidden" asp-for="FullName" />
                    <input type="hidden" asp-for="Email" />
                    <input type="hidden" asp-for="CurrentRole" />

                    <div class="mb-3">
                        <label asp-for="NewRole" class="form-label">الدور الجديد</label>
                        <select asp-for="NewRole" class="form-select">
                            <option value="Admin" selected="@(Model.CurrentRole == "Admin")">مدير النظام</option>
                            <option value="Manager" selected="@(Model.CurrentRole == "Manager")">مدير</option>
                            <option value="Employee" selected="@(Model.CurrentRole == "Employee")">موظف</option>
                        </select>
                        <span asp-validation-for="NewRole" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> تحديث الدور</button>
                        <a asp-action="Users" class="btn btn-outline-secondary">إلغاء</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
