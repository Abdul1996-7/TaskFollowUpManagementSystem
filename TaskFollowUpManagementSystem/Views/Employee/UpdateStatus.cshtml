@model UpdateTaskStatusViewModel
@{
    ViewData["Title"] = "Update Task Status";
}

<h2 class="mb-4"><i class="bi bi-pencil-square"></i> Update Task Status</h2>

<div class="row">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-body p-4">
                <div class="alert alert-info">
                    <strong>Task:</strong> @Model.Title<br />
                    <strong>Current Status:</strong>
                    @{
                        var currentBadge = Model.CurrentStatus switch
                        {
                            TaskStatusEnum.New => "bg-secondary",
                            TaskStatusEnum.Assigned => "bg-primary",
                            TaskStatusEnum.InProgress => "bg-info",
                            TaskStatusEnum.PendingReview => "bg-warning text-dark",
                            TaskStatusEnum.Overdue => "bg-danger",
                            TaskStatusEnum.Completed => "bg-success",
                            TaskStatusEnum.Closed => "bg-dark",
                            _ => "bg-secondary"
                        };
                    }
                    <span class="badge @currentBadge">@Model.CurrentStatus</span>
                </div>

                <form asp-action="UpdateStatus" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="TaskId" />
                    <input type="hidden" asp-for="Title" />
                    <input type="hidden" asp-for="CurrentStatus" />

                    <div class="mb-3">
                        <label asp-for="NewStatus" class="form-label">New Status</label>
                        <select asp-for="NewStatus" class="form-select">
                            <option value="@((int)TaskStatusEnum.InProgress)">In Progress</option>
                            <option value="@((int)TaskStatusEnum.PendingReview)">Pending Review</option>
                            <option value="@((int)TaskStatusEnum.Completed)">Completed</option>
                        </select>
                        <span asp-validation-for="NewStatus" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ProgressNote" class="form-label"></label>
                        <textarea asp-for="ProgressNote" class="form-control" rows="4" placeholder="Add a progress note..."></textarea>
                        <span asp-validation-for="ProgressNote" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success"><i class="bi bi-check-lg"></i> Update Status</button>
                        <a asp-action="TaskDetails" asp-route-id="@Model.TaskId" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
