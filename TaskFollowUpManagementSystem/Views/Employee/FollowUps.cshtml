@model FollowUpListViewModel
@{
    ViewData["Title"] = "متابعاتي";
}

<div class="page-header">
    <h2><i class="bi bi-chat-dots"></i> متابعاتي</h2>
</div>

<div class="card shadow">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>المهمة</th>
                        <th>المدير</th>
                        <th>تاريخ المتابعة</th>
                        <th>الملاحظة</th>
                        <th>الحالة</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.FollowUps.Any())
                    {
                        @foreach (var followUp in Model.FollowUps)
                        {
                            <tr>
                                <td>
                                    <a asp-action="TaskDetails" asp-route-id="@followUp.TaskItemId" class="text-decoration-none fw-bold">
                                        @followUp.TaskTitle
                                    </a>
                                </td>
                                <td>@followUp.ManagerName</td>
                                <td>@followUp.FollowUpDate.ToString("yyyy/MM/dd")</td>
                                <td>
                                    @if (followUp.Note.Length > 50)
                                    {
                                        @followUp.Note.Substring(0, 50)<text>...</text>
                                    }
                                    else
                                    {
                                        @followUp.Note
                                    }
                                </td>
                                <td>
                                    @if (followUp.HasResponse)
                                    {
                                        <span class="badge bg-success">تم الرد</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">بانتظار الرد</span>
                                    }
                                </td>
                                <td>
                                    @if (!followUp.HasResponse)
                                    {
                                        <a asp-action="RespondFollowUp" asp-route-id="@followUp.FollowUpId" class="btn btn-sm btn-primary">
                                            <i class="bi bi-reply"></i> الرد
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6">
                                <div class="empty-state">
                                    <div class="empty-icon"><i class="bi bi-chat-dots"></i></div>
                                    <div class="empty-title">لا توجد متابعات</div>
                                    <div class="empty-text">لم يتم إضافة أي متابعات لمهامك بعد</div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="FollowUps" asp-route-page="@(Model.CurrentPage - 1)">السابق</a>
            </li>
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                    <a class="page-link" asp-action="FollowUps" asp-route-page="@i">@i</a>
                </li>
            }
            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="FollowUps" asp-route-page="@(Model.CurrentPage + 1)">التالي</a>
            </li>
        </ul>
    </nav>
}
