@model TaskDetailsViewModel
@{
    ViewData["Title"] = "تفاصيل المهمة";
}

<div class="page-header">
    <h2><i class="bi bi-info-circle"></i> تفاصيل المهمة</h2>
    <div>
        <a asp-action="UpdateStatus" asp-route-id="@Model.TaskId" class="btn btn-outline-success"><i class="bi bi-pencil-square"></i> تحديث الحالة</a>
        <a asp-action="MyTasks" class="btn btn-outline-secondary"><i class="bi bi-arrow-right"></i> رجوع</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-8">
        <div class="card shadow">
            <div class="card-header bg-light">
                <h4 class="mb-0">@Model.Title</h4>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="info-row">
                            <span class="info-label">أسندت بواسطة:</span>
                            <span class="info-value">@Model.AssignedByName</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="info-row">
                            <span class="info-label">مسندة إلى:</span>
                            <span class="info-value">@Model.AssignedToName</span>
                        </div>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-4">
                        <div class="info-row">
                            <span class="info-label">تاريخ البداية:</span>
                            <span class="info-value">@Model.StartDate.ToString("yyyy/MM/dd")</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="info-row">
                            <span class="info-label">تاريخ الاستحقاق:</span>
                            <span class="info-value">
                                @Model.DueDate.ToString("yyyy/MM/dd")
                                @if (Model.IsOverdue)
                                {
                                    <span class="badge bg-danger">متأخرة</span>
                                }
                            </span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="info-row">
                            <span class="info-label">المدة المتوقعة:</span>
                            <span class="info-value">@(Model.ExpectedDuration ?? "غير محدد")</span>
                        </div>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-4">
                        <div class="info-row">
                            <span class="info-label">الأولوية:</span>
                            <span class="info-value">
                                @{
                                    var priorityBadge = Model.Priority switch
                                    {
                                        PriorityLevel.Low => "bg-secondary",
                                        PriorityLevel.Medium => "bg-info",
                                        PriorityLevel.High => "bg-warning text-dark",
                                        PriorityLevel.Critical => "bg-danger",
                                        _ => "bg-secondary"
                                    };
                                }
                                <span class="badge @priorityBadge">@Model.Priority</span>
                            </span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="info-row">
                            <span class="info-label">الحالة:</span>
                            <span class="info-value">
                                @{
                                    var statusBadge = Model.Status switch
                                    {
                                        TaskStatusEnum.New => "bg-secondary",
                                        TaskStatusEnum.Assigned => "bg-primary",
                                        TaskStatusEnum.InProgress => "bg-info",
                                        TaskStatusEnum.PendingReview => "bg-warning text-dark",
                                        TaskStatusEnum.Overdue => "bg-danger",
                                        TaskStatusEnum.Completed => "bg-success",
                                        TaskStatusEnum.Closed => "bg-dark",
                                        _ => "bg-secondary"
                                    };
                                }
                                <span class="badge @statusBadge">@Model.Status</span>
                            </span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="info-row">
                            <span class="info-label">آخر تحديث:</span>
                            <span class="info-value">@Model.UpdatedAt.ToString("yyyy/MM/dd HH:mm")</span>
                        </div>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <div class="mb-3">
                        <strong>الوصف:</strong>
                        <p class="mt-1">@Model.Description</p>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.ProgressNote))
                {
                    <div class="mb-3">
                        <strong>ملاحظات التقدم:</strong>
                        <p class="mt-1 text-muted">@Model.ProgressNote</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow">
            <div class="card-header bg-light">
                <h5 class="mb-0"><i class="bi bi-lightning"></i> إجراءات سريعة</h5>
            </div>
            <div class="card-body">
                <a asp-action="UpdateStatus" asp-route-id="@Model.TaskId" class="btn btn-success w-100 mb-2">
                    <i class="bi bi-pencil-square"></i> تحديث الحالة
                </a>
                <a asp-action="FollowUps" class="btn btn-outline-info w-100">
                    <i class="bi bi-chat-dots"></i> عرض المتابعات
                </a>
            </div>
        </div>
    </div>
</div>

<!-- قسم المتابعات -->
<div class="card shadow mt-4">
    <div class="card-header bg-light">
        <h5 class="mb-0"><i class="bi bi-chat-dots"></i> سجل المتابعات (@Model.FollowUps.Count)</h5>
    </div>
    <div class="card-body">
        @if (Model.FollowUps.Any())
        {
            @foreach (var followUp in Model.FollowUps)
            {
                <div class="followup-thread">
                    <div class="d-flex justify-content-between mb-2">
                        <strong><i class="bi bi-person-badge"></i> @followUp.ManagerName</strong>
                        <small class="text-muted">@followUp.FollowUpDate.ToString("yyyy/MM/dd")</small>
                    </div>
                    <p class="mb-2">@followUp.Note</p>
                    @if (!string.IsNullOrEmpty(followUp.EmployeeResponse))
                    {
                        <div class="followup-response">
                            <small class="text-success fw-bold"><i class="bi bi-reply"></i> ردك:</small>
                            <p class="mb-0 small">@followUp.EmployeeResponse</p>
                            <small class="text-muted">@followUp.ResponseDate?.ToString("yyyy/MM/dd HH:mm")</small>
                        </div>
                    }
                    else
                    {
                        <a asp-action="RespondFollowUp" asp-route-id="@followUp.FollowUpId" class="btn btn-sm btn-primary">
                            <i class="bi bi-reply"></i> الرد
                        </a>
                    }
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon"><i class="bi bi-chat-dots"></i></div>
                <div class="empty-title">لا توجد متابعات بعد</div>
            </div>
        }
    </div>
</div>
