@model RespondFollowUpViewModel
@{
    ViewData["Title"] = "Respond to Follow-Up";
}

<h2 class="mb-4"><i class="bi bi-reply"></i> Respond to Follow-Up</h2>

<div class="row">
    <div class="col-md-8">
        <div class="card shadow">
            <div class="card-body p-4">
                <div class="alert alert-info">
                    <strong>Task:</strong> @Model.TaskTitle<br />
                    <strong>Manager:</strong> @Model.ManagerName<br />
                    <strong>Follow-Up Date:</strong> @Model.FollowUpDate.ToString("MMM dd, yyyy")
                </div>

                <div class="border rounded p-3 mb-4 bg-light">
                    <strong><i class="bi bi-chat-left-text"></i> Manager's Note:</strong>
                    <p class="mt-2 mb-0">@Model.Note</p>
                </div>

                <form asp-action="RespondFollowUp" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="FollowUpId" />
                    <input type="hidden" asp-for="TaskTitle" />
                    <input type="hidden" asp-for="ManagerName" />
                    <input type="hidden" asp-for="FollowUpDate" />
                    <input type="hidden" asp-for="Note" />

                    <div class="mb-3">
                        <label asp-for="EmployeeResponse" class="form-label"></label>
                        <textarea asp-for="EmployeeResponse" class="form-control" rows="5" placeholder="Type your response here..."></textarea>
                        <span asp-validation-for="EmployeeResponse" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-send"></i> Submit Response</button>
                        <a asp-action="FollowUps" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
