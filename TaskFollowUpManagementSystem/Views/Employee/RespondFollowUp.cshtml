@model RespondFollowUpViewModel
@{
    ViewData["Title"] = "الرد على المتابعة";
}

<div class="page-header">
    <h2><i class="bi bi-reply"></i> الرد على المتابعة</h2>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card shadow">
            <div class="card-body p-4">
                <div class="alert alert-info">
                    <strong>المهمة:</strong> @Model.TaskTitle<br />
                    <strong>المدير:</strong> @Model.ManagerName<br />
                    <strong>تاريخ المتابعة:</strong> @Model.FollowUpDate.ToString("yyyy/MM/dd")
                </div>

                <div class="followup-thread mb-4">
                    <strong><i class="bi bi-chat-left-text"></i> ملاحظة المدير:</strong>
                    <p class="mt-2 mb-0">@Model.Note</p>
                </div>

                <form asp-action="RespondFollowUp" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="FollowUpId" />
                    <input type="hidden" asp-for="TaskTitle" />
                    <input type="hidden" asp-for="ManagerName" />
                    <input type="hidden" asp-for="FollowUpDate" />
                    <input type="hidden" asp-for="Note" />

                    <div class="mb-3">
                        <label asp-for="EmployeeResponse" class="form-label">ردك</label>
                        <textarea asp-for="EmployeeResponse" class="form-control" rows="5" placeholder="اكتب ردك هنا..."></textarea>
                        <span asp-validation-for="EmployeeResponse" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-send"></i> إرسال الرد</button>
                        <a asp-action="FollowUps" class="btn btn-outline-secondary">إلغاء</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
