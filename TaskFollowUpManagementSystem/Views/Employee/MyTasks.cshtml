@model TaskListViewModel
@{
    ViewData["Title"] = "مهامي";
}

<div class="page-header">
    <h2><i class="bi bi-list-task"></i> مهامي</h2>
</div>

<!-- الفلاتر -->
<div class="card shadow mb-4 filter-card">
    <div class="card-body">
        <form method="get" asp-action="MyTasks" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label">بحث</label>
                <input type="text" name="search" value="@Model.SearchTerm" class="form-control" placeholder="ابحث في المهام..." />
            </div>
            <div class="col-md-3">
                <label class="form-label">الأولوية</label>
                <select name="priority" class="form-select">
                    <option value="">جميع الأولويات</option>
                    @foreach (PriorityLevel p in Enum.GetValues(typeof(PriorityLevel)))
                    {
                        <option value="@((int)p)" selected="@(Model.PriorityFilter == p)">@p</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">الحالة</label>
                <select name="status" class="form-select">
                    <option value="">جميع الحالات</option>
                    @foreach (TaskStatusEnum s in Enum.GetValues(typeof(TaskStatusEnum)))
                    {
                        <option value="@((int)s)" selected="@(Model.StatusFilter == s)">@s</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-search"></i> بحث</button>
            </div>
        </form>
    </div>
</div>

<!-- جدول المهام -->
<div class="card shadow">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>العنوان</th>
                        <th>تاريخ الاستحقاق</th>
                        <th>الأولوية</th>
                        <th>الحالة</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Tasks.Any())
                    {
                        @foreach (var task in Model.Tasks)
                        {
                            <tr>
                                <td>
                                    <a asp-action="TaskDetails" asp-route-id="@task.TaskId" class="text-decoration-none fw-bold">@task.Title</a>
                                </td>
                                <td>
                                    @task.DueDate.ToString("yyyy/MM/dd")
                                    @if (task.IsOverdue)
                                    {
                                        <span class="badge bg-danger">متأخرة</span>
                                    }
                                </td>
                                <td>
                                    @{
                                        var priorityBadge = task.Priority switch
                                        {
                                            PriorityLevel.Low => "bg-secondary",
                                            PriorityLevel.Medium => "bg-info",
                                            PriorityLevel.High => "bg-warning text-dark",
                                            PriorityLevel.Critical => "bg-danger",
                                            _ => "bg-secondary"
                                        };
                                    }
                                    <span class="badge @priorityBadge">@task.Priority</span>
                                </td>
                                <td>
                                    @{
                                        var statusBadge = task.Status switch
                                        {
                                            TaskStatusEnum.New => "bg-secondary",
                                            TaskStatusEnum.Assigned => "bg-primary",
                                            TaskStatusEnum.InProgress => "bg-info",
                                            TaskStatusEnum.PendingReview => "bg-warning text-dark",
                                            TaskStatusEnum.Overdue => "bg-danger",
                                            TaskStatusEnum.Completed => "bg-success",
                                            TaskStatusEnum.Closed => "bg-dark",
                                            _ => "bg-secondary"
                                        };
                                    }
                                    <span class="badge @statusBadge">@task.Status</span>
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="TaskDetails" asp-route-id="@task.TaskId" class="btn btn-outline-primary" title="التفاصيل"><i class="bi bi-eye"></i></a>
                                        <a asp-action="UpdateStatus" asp-route-id="@task.TaskId" class="btn btn-outline-success" title="تحديث الحالة"><i class="bi bi-pencil-square"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5">
                                <div class="empty-state">
                                    <div class="empty-icon"><i class="bi bi-clipboard-x"></i></div>
                                    <div class="empty-title">لا توجد مهام</div>
                                    <div class="empty-text">لم يتم العثور على مهام مطابقة</div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="MyTasks" asp-route-page="@(Model.CurrentPage - 1)"
                   asp-route-search="@Model.SearchTerm" asp-route-priority="@Model.PriorityFilter"
                   asp-route-status="@Model.StatusFilter">السابق</a>
            </li>
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                    <a class="page-link" asp-action="MyTasks" asp-route-page="@i"
                       asp-route-search="@Model.SearchTerm" asp-route-priority="@Model.PriorityFilter"
                       asp-route-status="@Model.StatusFilter">@i</a>
                </li>
            }
            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="MyTasks" asp-route-page="@(Model.CurrentPage + 1)"
                   asp-route-search="@Model.SearchTerm" asp-route-priority="@Model.PriorityFilter"
                   asp-route-status="@Model.StatusFilter">التالي</a>
            </li>
        </ul>
    </nav>
}
