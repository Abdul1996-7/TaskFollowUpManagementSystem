@model EmployeeDashboardViewModel
@{
    ViewData["Title"] = "لوحة تحكم الموظف";
}

<div class="page-header">
    <h2><i class="bi bi-speedometer2"></i> لوحة التحكم</h2>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card stat-card bg-primary text-white shadow h-100">
            <div class="card-body text-center">
                <div class="stat-icon"><i class="bi bi-list-task"></i></div>
                <div class="stat-number">@Model.AssignedTasks</div>
                <p class="stat-label">المهام النشطة</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card bg-warning text-dark shadow h-100">
            <div class="card-body text-center">
                <div class="stat-icon"><i class="bi bi-chat-dots"></i></div>
                <div class="stat-number">@Model.PendingFollowUps</div>
                <p class="stat-label">متابعات بانتظار الرد</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card bg-success text-white shadow h-100">
            <div class="card-body text-center">
                <div class="stat-icon"><i class="bi bi-check-circle"></i></div>
                <div class="stat-number">@Model.CompletedTasks</div>
                <p class="stat-label">المهام المكتملة</p>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-clock"></i> المواعيد النهائية القادمة</h5>
                <a asp-action="MyTasks" class="btn btn-sm btn-outline-primary">عرض الكل</a>
            </div>
            <div class="card-body p-0">
                @if (Model.UpcomingDeadlines.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var deadline in Model.UpcomingDeadlines)
                        {
                            <a asp-action="TaskDetails" asp-route-id="@deadline.TaskId" class="list-group-item list-group-item-action">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>@deadline.Title</strong><br />
                                        <small class="text-muted">الاستحقاق: @deadline.DueDate.ToString("yyyy/MM/dd")</small>
                                    </div>
                                    <div>
                                        @if (deadline.DaysRemaining <= 1)
                                        {
                                            <span class="badge bg-danger">@deadline.DaysRemaining يوم</span>
                                        }
                                        else if (deadline.DaysRemaining <= 3)
                                        {
                                            <span class="badge bg-warning text-dark">@deadline.DaysRemaining أيام</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info">@deadline.DaysRemaining أيام</span>
                                        }
                                    </div>
                                </div>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <div class="empty-icon"><i class="bi bi-clock"></i></div>
                        <div class="empty-title">لا توجد مواعيد نهائية قادمة</div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-light">
                <h5 class="mb-0"><i class="bi bi-list-task"></i> آخر المهام</h5>
            </div>
            <div class="card-body p-0">
                @if (Model.RecentTasks.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var task in Model.RecentTasks)
                        {
                            <a asp-action="TaskDetails" asp-route-id="@task.TaskId" class="list-group-item list-group-item-action">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>@task.Title</strong>
                                    </div>
                                    <div>
                                        @{
                                            var statusBadge = task.Status switch
                                            {
                                                TaskStatusEnum.New => "bg-secondary",
                                                TaskStatusEnum.Assigned => "bg-primary",
                                                TaskStatusEnum.InProgress => "bg-info",
                                                TaskStatusEnum.PendingReview => "bg-warning text-dark",
                                                TaskStatusEnum.Overdue => "bg-danger",
                                                TaskStatusEnum.Completed => "bg-success",
                                                TaskStatusEnum.Closed => "bg-dark",
                                                _ => "bg-secondary"
                                            };
                                        }
                                        <span class="badge @statusBadge">@task.Status</span>
                                    </div>
                                </div>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <div class="empty-icon"><i class="bi bi-list-task"></i></div>
                        <div class="empty-title">لا توجد مهام مسندة بعد</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
